__pycache__/
*.pyc
*.pyo
.DS_Store
.ipynb_checkpoints/

# data + large outputs — not tracked (fetch via data/README.md)
*.npz
*.h5ad
*.h5
*.loom
*.mtx
*.mtx.gz
*.tsv.gz
*.txt.gz
*.tar
*.rda
*.rds
data/*/
**/results/
**/data/prepared/
*.log

# default I/O roots created by own_baseline/paths.py
data/runs/
data/scratch/

# the frozen run artefacts the figures read — evidence, not a build artefact
!data/run_record/
!data/run_record/**

# reproduction outputs
reproduction/

# null calibration raw output is evidence, not a build artefact
!experiments/null_calibration/results/
!experiments/null_calibration/results/*.csv
!experiments/null_calibration/results/*.log

# the w5 new-row summaries are small and are the record; per-row JSON stays
# under $OWNBASELINE_DATA_ROOT
!experiments/w5_new_rows/results/
!experiments/w5_new_rows/results/*.json

# third-party reference code (MCE.m and its supplement): fetched by URL, see
# experiments/w5_new_rows/DISCOVERY.md
/reference/

# packaging build artefacts, not evidence
own_baseline.egg-info/
*.egg-info/
build/
dist/
